{
  "info": {"name": "Bike Share API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://localhost:8000/api/v1"}],
  "item": [
    {"name": "Health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"username\":\"operator\",\"password\":\"Operator123!\"}"}, "url": "{{baseUrl}}/auth/login"}},
    {"name": "Categories", "request": {"method": "GET", "url": "{{baseUrl}}/categories"}},
    {"name": "Bicycles", "request": {"method": "GET", "url": "{{baseUrl}}/bicycles?size=50"}},
    {"name": "Users", "request": {"method": "GET", "url": "{{baseUrl}}/users?size=50"}},
    {"name": "Rentals", "request": {"method": "GET", "url": "{{baseUrl}}/rentals?size=50"}},
    {"name": "Overdue", "request": {"method": "GET", "url": "{{baseUrl}}/rentals/overdue"}},
    {"name": "Most requested", "request": {"method": "GET", "url": "{{baseUrl}}/reports/most-requested?from=2026-11-01&to=2026-11-30"}}
  ]
}
